# Copy to .env and fill in. Leave Supabase blank to use the local dev login.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_DB_URL=
SUPABASE_STORAGE_BUCKET=samples

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

VIRUSTOTAL_API_KEY=
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Alert Service. Alerts always work; email notifications are optional.
ALERT_MIN_LEVEL=high
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
ALERT_EMAIL_FROM=threatlens@localhost
ALERT_EMAIL_TO=
