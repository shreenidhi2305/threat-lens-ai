# Copy to .env and fill in. Leave Supabase blank to use the local dev login.

# --- Environment ------------------------------------------------------------
# 'production' refuses to start with the default JWT secret, no identity provider,
# or the dev login enabled (see backend/app/core/startup_checks.py).
APP_ENV=development
# Demo deployment with no Supabase: allow the dev login, but gate it with a shared password
# (at least 12 characters). Never use with real data. `python deploy/make_env.py --demo` fills these in.
ALLOW_DEV_LOGIN=false
DEV_LOGIN_PASSWORD=
# Port the Docker stack publishes the UI on.
WEB_PORT=8080
# Set true behind a reverse proxy / load balancer so rate limits see the real client IP.
TRUST_PROXY_HEADERS=false

# --- Identity, data and storage (Supabase) ----------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_DB_URL=
SUPABASE_STORAGE_BUCKET=samples

# --- Auth ---------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Web ------------------------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser (your frontend URL).
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- API gateway (also editable at runtime in the Admin Console) -----------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=240
LOGIN_RATE_LIMIT_PER_MINUTE=20
MAX_UPLOAD_MB=32
MAX_CONCURRENT_SCANS=2

# --- Threat intelligence -------------------------------------------------------------
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_TIMEOUT_SECONDS=4

# --- Alert Service ------------------------------------------------------------------
# Alerts always work; email and SIEM forwarding are optional.
ALERT_MIN_LEVEL=high
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
ALERT_EMAIL_FROM=threatlens@localhost
ALERT_EMAIL_TO=

# SIEM / SOAR: alerts and incidents are POSTed as signed JSON events.
SIEM_WEBHOOK_URL=
SIEM_WEBHOOK_TOKEN=
SIEM_WEBHOOK_SECRET=
